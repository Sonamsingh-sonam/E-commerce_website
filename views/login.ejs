<%- include('./partials/header') %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 p-3 rounded-md bg-red-500">
        <span class="inline-block text-white"><%= error %></span>
    </div>
<% } %>

<div class="w-full min-h-screen flex items-center justify-center px-6 pt-20 bg-red-50">
    <div class="w-full max-w-md">
        <h4 class="text-3xl mb-5">Login to your account</h4>
        <form autocomplete="off" action="/users/login" method="post">
            <input class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                   type="email" placeholder="Email" name="email">
            <input class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
                   type="password" placeholder="Password" name="password">
            <input class="px-5 block rounded-full py-3 mt-2 bg-red-950 text-white" type="submit" value="Login">
        </form>
        <p class="mt-5 text-sm">New here? <a class="underline text-red-950" href="/register">Create an account</a></p>
    </div>
</div>

<%- include('./partials/footer') %>