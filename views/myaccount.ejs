<%- include('./partials/header') %>

<div class="w-full min-h-screen px-20 py-28">
    <h2 class="text-3xl mb-8">My Account</h2>

    <div class="max-w-md border rounded-md p-6">
        <div class="mb-4">
            <p class="text-sm opacity-60">Full Name</p>
            <p class="text-lg"><%= user.fullname %></p>
        </div>
        <div class="mb-4">
            <p class="text-sm opacity-60">Email</p>
            <p class="text-lg"><%= user.email %></p>
        </div>
        <div class="mb-4">
            <p class="text-sm opacity-60">Items in cart</p>
            <p class="text-lg"><%= user.cart.length %></p>
        </div>
        <div class="mb-6">
            <p class="text-sm opacity-60">Orders placed</p>
            <p class="text-lg"><%= user.orders.length %></p>
        </div>

        <div class="flex gap-3">
            <a href="/cart" class="px-4 py-2 rounded-md bg-red-950 text-white">Go to cart</a>
            <a href="/logout" class="px-4 py-2 rounded-md border border-red-950 text-red-950">Logout</a>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>