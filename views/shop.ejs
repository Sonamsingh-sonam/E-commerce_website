<%- include('./partials/header') %>

<% if (typeof success !== 'undefined' && success.length > 0) { %>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 z-10 p-3 rounded-md bg-blue-500">
        <span class="inline-block mt-1 mb-1 text-white">
            <%= success %>
        </span>
    </div>
<% } %>

<div class="w-full min-h-screen flex flex-col md:flex-row items-start px-5 md:px-20 py-24 md:py-20 gap-6 md:gap-10">

    <div class="w-full md:w-[22%] flex flex-col items-start">
        <div class="flex flex-wrap items-center gap-2">
            <h3>sort by</h3>
            <form action="/shop">
                <select class="border-[1px] px-2 py-1" name="sortby">
                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>
                </select>
            </form>
        </div>
        <div class="flex flex-row flex-wrap gap-x-5 md:flex-col mt-4 md:mt-20">
            <a class="block w-fit mb-2" href="/shop?filter=new">New Collection</a>
            <a class="block w-fit mb-2" href="/shop">All Products</a>
            <a class="block w-fit mb-2" href="/shop?filter=discounted">Discounted Products</a>
        </div>
    </div>

    <div class="w-full md:w-[82%] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
        <% products.forEach(function (product) {
             const bgStyle = 'background:' + product.bgcolor + ';';
             const panelStyle = 'background:' + product.panelcolor + ';color:' + product.textcolor + ';';
        %>
            <div class="w-full">
                <div class="w-full h-96 flex items-center justify-center" style="<%= bgStyle %>">
                    <img class="h-full max-w-full object-contain p-1"
                         src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="">
                </div>
                <div class="flex justify-between items-center px-4 py-4" style="<%= panelStyle %>">
                    <div>
                        <h3><%= product.name %></h3>
                        
                       <h4>
    <% if (product.discount > 0) { %>
        <span class="line-through opacity-60 mr-2">₹ <%= product.price %></span>
    <% } %>
    <span class="font-semibold">₹ <%= product.price - (product.discount || 0) %></span>
</h4>
                    </div>
                    <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white text-black"
                       href="/addtocart/<%= product._id %>">
                        <i class="ri-add-line"></i>
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('./partials/footer') %>