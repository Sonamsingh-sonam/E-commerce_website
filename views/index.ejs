<%- include('./partials/header') %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="absolute top-24 left-1/2 -translate-x-1/2 z-20 p-3 rounded-md bg-red-500">
        <span class="inline-block text-white"><%= error %></span>
    </div>
<% } %>

<div class="relative w-full min-h-screen flex items-center px-6 md:px-20 pt-24"
     style="background-image: url('/images/index.jpg'); background-size: cover; background-position: center;">

    <div class="absolute inset-0 bg-black/65"></div>

    <div class="relative z-10 max-w-xl text-white" style="text-shadow: 0 2px 8px rgba(0,0,0,0.6);">
        <h1 class="text-4xl md:text-6xl">
            Welcome to <span class="font-semibold">Scatch</span>
        </h1>
        <p class="mt-4 text-base md:text-lg text-zinc-200">
            Handbags, clutches and more, picked just for you.
        </p>

        <div class="flex flex-wrap gap-4 mt-8">
            <a href="/login" class="px-6 py-3 rounded-full bg-white text-red-950">Login</a>
            <a href="/register" class="px-6 py-3 rounded-full border border-white text-white">Create Account</a>
        </div>

        <div class="mt-12 pt-6 border-t border-white/30">
            <p class="text-sm text-zinc-300">Are you the store owner?</p>
            <a href="/owners/admin" class="underline">Owner Panel</a>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>